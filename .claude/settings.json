{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/block_inplace_sed.py\" 2>/dev/null",
            "timeout": 20,
            "statusMessage": "in-place 置換のチェック"
          }
        ]
      }
    ]
  }
}