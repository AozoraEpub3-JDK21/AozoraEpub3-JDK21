<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:xml="http://www.w3.org/XML/1998/namespace" xml:lang="ja" lang="ja">

<head>
#if (${bookInfo.ImageOnly} && ${pageSize} && ${coverImage})
#set ($place = $pageSize.place($coverImage))
	<meta name="viewport" content="width=${pageSize.Width}, height=${pageSize.Height}"/>
#end
#if (${svgImage} && ${bookInfo.ImageOnly})
	<link rel="stylesheet" type="text/css" href="../css/svg_image.css"/>
#elseif (${kindle} && ${bookInfo.ImageOnly})
	<link rel="stylesheet" type="text/css" href="../css/kindle_image.css"/>
#elseif (${bookInfo.Vertical})
	<link rel="stylesheet" type="text/css" href="../css/vertical_image.css"/>
#else
	<link rel="stylesheet" type="text/css" href="../css/horizontal_image.css"/>
#end
	<title>${title}</title>
#if (${bookInfo.ImageOnly} && ${pageSize} && ${coverImage})
<style type="text/css">
html,body{margin:0;padding:0;width:${pageSize.Width}px;height:${pageSize.Height}px;overflow:hidden}
img{position:absolute;left:${place.X}px;top:${place.Y}px;width:${place.Width}px;height:${place.Height}px;max-width:none;max-height:none;min-height:0;margin:0}
</style>
#elseif (${sectionInfo.ImageHeight} > 0)
<style type="text/css">
body .img img {
height: ${sectionInfo.ImageHeightPercent}%;
min-height: ${sectionInfo.ImageHeightPercent}%;
}
</style>
#end
</head>

#if (${svgImage} && ${bookInfo.ImageOnly})
<body>
<div>
<svg xmlns="http://www.w3.org/2000/svg" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" width="100%" height="100%" viewBox="0 0 ${pageSize.Width} ${pageSize.Height}">
<image x="${place.X}" y="${place.Y}" width="${place.Width}" height="${place.Height}" xlink:href="../images/${coverImage.OutFileName}"/>
</svg>
</div>
</body>
#else
#if (${bookInfo.ImageOnly} && ${pageSize})
<body>
#elseif (${sectionInfo.ImageFitW})
<body class="fit_w">
#elseif (${sectionInfo.ImageFitH})
<body class="fit_h">
#else
<body>
#end
<span class="img"><img src="../images/${coverImage.OutFileName}"/></span>
</body>
#end

</html>